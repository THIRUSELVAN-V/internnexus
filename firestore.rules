rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || hasRole('admin'));
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if true;
      allow create: if hasRole('hr') || hasRole('admin');
      allow update, delete: if hasRole('admin') || (hasRole('hr') && resource.data.hrId == request.auth.uid);
    }

    // Internships Collection
    match /internships/{internshipId} {
      allow read: if true;
      allow create, update, delete: if hasRole('hr') || hasRole('admin');
    }

    // Applications Collection
    match /applications/{applicationId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('student');
      allow update: if hasRole('hr') || hasRole('mentor') || hasRole('admin') || resource.data.studentId == request.auth.uid;
      allow delete: if hasRole('admin');
    }

    // Mentor Assignments Collection
    match /mentorAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update: if hasRole('hr') || hasRole('admin') || hasRole('mentor');
      allow delete: if hasRole('admin');
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasRole('mentor') || hasRole('admin');
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('student');
      allow update: if hasRole('student') || hasRole('mentor') || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // Feedback Collection
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated();
      allow create, update: if hasRole('mentor') || hasRole('admin');
    }

    // Certificates Collection
    match /certificates/{certificateId} {
      allow read: if isAuthenticated();
      allow create, update: if hasRole('hr') || hasRole('admin');
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if isAuthenticated();
    }
  }
}
